{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "allowUnreachableCode": false,
    "allowUnusedLabels": false, "verbatimModuleSyntax": true, "isolatedModules": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": false
  },
  "include": ["src", "scripts", "tests", "dev", "*.ts"]
}
